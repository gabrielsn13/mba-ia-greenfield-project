# Frontend (Next.js) - copie para .env.local e ajuste.
# API_URL: backend NestJS. As stacks Docker sao separadas, entao o container acessa o host.
API_URL=http://host.docker.internal:3000
# SESSION_PASSWORD: segredo do iron-session, minimo de 32 caracteres. Gere um valor proprio.
SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars-or-more
